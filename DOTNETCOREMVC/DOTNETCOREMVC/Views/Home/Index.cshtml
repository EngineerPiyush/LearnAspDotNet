@using ModelInDotNetCore.Models;
@{
    ViewData["Title"] = "Home Page";
    var students = ViewData["myStudents"] as List<StudentModel>;
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.
        </p>
        <p>you have moved towards ahead in .net journey</p>
</div>

<table border="1">
        <tr>
        <th>Roll No</th>
        <th>Name</th>
        <th>Age</th>
        <th>City</th>
        </tr>

    @{
        foreach(var student in students)
        {
            <tr>
            <td>@student.rollNo</td>
            <td>@student.name</td>
            <td>@student.age</td>
            <td>@student.city</td>
            </tr>
        }
    }

</table>
